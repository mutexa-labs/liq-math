{
  "name": "@mutexa/liq-math",
  "version": "0.1.0",
  "description": "Liquidation price math for Hyperliquid perps, Aave V3 and Morpho Blue loans, checked against the venues' own numbers with golden vectors.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/liq-math.git"
  },
  "homepage": "https://github.com/mutexa-labs/liq-math#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/liq-math/issues"
  },
  "keywords": [
    "liquidation",
    "liquidation-price",
    "hyperliquid",
    "perps",
    "aave",
    "morpho",
    "health-factor",
    "golden-vectors",
    "mutexa"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "files": [
    "dist",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "test": "vitest run",
    "record": "node scripts/record-hyperliquid.ts && node scripts/record-aave.ts && node scripts/record-morpho.ts",
    "record:hyperliquid": "node scripts/record-hyperliquid.ts",
    "record:aave": "node scripts/record-aave.ts",
    "record:morpho": "node scripts/record-morpho.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.7",
    "vitest": "^3.2.7"
  }
}
